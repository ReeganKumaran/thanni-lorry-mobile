# Base URL of the AURA FastAPI backend, as reachable FROM THE PHONE.
# Leave unset in Expo Go: the app derives your laptop's LAN IP from the Expo
# dev-server host and talks to http://<that-ip>:8000.
# Set it explicitly when the backend runs somewhere else (tunnel, staging, LAN IP).
EXPO_PUBLIC_AURA_API_URL=http://192.168.1.10:8000

# OpenRouteService key — enables the real `foot-walking` profile, which routes
# along footways and crossings instead of roads. Free tier at
# https://openrouteservice.org/dev/#/signup (2000 requests/day; AURA makes one
# per journey). Without it the app falls back to OSRM's public demo server,
# which only hosts the car profile.
EXPO_PUBLIC_ORS_API_KEY=
