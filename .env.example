# Base URL of the AURA FastAPI backend, as reachable FROM THE PHONE.
# Leave unset in Expo Go: the app derives your laptop's LAN IP from the Expo
# dev-server host and talks to http://<that-ip>:8000.
# Set it explicitly when the backend runs somewhere else (tunnel, staging, LAN IP).
EXPO_PUBLIC_AURA_API_URL=http://192.168.1.10:8000

# There is deliberately NO maps or routing key here.
#
# Geocoding and route planning happen in services/api, which holds the
# credential. EXPO_PUBLIC_* values are compiled into the app bundle, and a
# bundle is not a secret — anyone with the APK can read one out. The phone posts
# {latitude, longitude, speed} and receives a polyline.
#
# Map rendering needs no key either: the map draws OpenStreetMap raster tiles,
# so rendering can never be the thing that breaks.
#
# To use a real walking router, set GOOGLE_MAPS_API_KEY in the BACKEND's .env
# (thanni-lorry-backend/.env). See that repo's .env.example.
